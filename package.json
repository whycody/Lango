{
  "name": "lango",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios:dev": "cross-env APP_VARIANT=development expo run:ios --device",
    "ios:dev:prebuild": "cross-env APP_VARIANT=development expo prebuild --platform ios --clean",
    "ios:dev:build": "cross-env APP_VARIANT=development expo prebuild --platform ios --clean && cross-env APP_VARIANT=development expo run:ios --device",
    "ios:test": "cross-env APP_VARIANT=test expo run:ios --device --configuration Release",
    "ios:test:prebuild": "cross-env APP_VARIANT=test expo prebuild --platform ios --clean",
    "ios:test:build": "cross-env APP_VARIANT=test expo prebuild --platform ios --clean && cross-env APP_VARIANT=test expo run:ios --device --configuration Release",
    "ios:production": "cross-env APP_VARIANT=production expo run:ios --device --configuration Release",
    "ios:production:prebuild": "cross-env APP_VARIANT=production expo prebuild --platform ios --clean",
    "ios:production:build": "cross-env APP_VARIANT=production expo prebuild --platform ios --clean && cross-env APP_VARIANT=production expo run:ios --device --configuration Release",
    "android:dev": "cross-env APP_VARIANT=development expo run:android",
    "android:dev:prebuild": "cross-env APP_VARIANT=development expo prebuild --platform android --clean",
    "android:dev:build": "cross-env APP_VARIANT=development expo prebuild --platform android --clean && cross-env APP_VARIANT=development expo run:android ",
    "android:production": "cross-env APP_VARIANT=production expo run:android --device --variant release",
    "android:production:prebuild": "cross-env APP_VARIANT=production expo prebuild --platform android --clean --variant release",
    "android:production:build": "cross-env APP_VARIANT=production expo prebuild --platform android --clean && cross-env APP_VARIANT=production expo run:android --device --variant release",
    "android:test": "cross-env APP_VARIANT=test expo run:android --device --variant release",
    "android:test:prebuild": "cross-env APP_VARIANT=test expo prebuild --platform android --clean --variant release",
    "android:test:build": "cross-env APP_VARIANT=test expo prebuild --platform android --clean && cross-env APP_VARIANT=test expo run:android --device --variant release",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "fix:all": "npm run lint:fix && npm run format",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@animatereactnative/marquee": "~0.5.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "5.2.9",
    "@lodev09/react-native-true-sheet": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.5",
    "@types/react": "~19.2.10",
    "apisauce": "^3.2.2",
    "axios": "^1.15.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.9",
    "i18next": "^23.16.2",
    "intl-pluralrules": "~2.0.1",
    "lodash.debounce": "^4.0.8",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-i18next": "~15.1.0",
    "react-native": "0.86.0",
    "react-native-device-info": "^14.0.4",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-fbsdk-next": "~13.4.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-localize": "~3.2.1",
    "react-native-mmkv": "^4.0.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "~5.12.5",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sqlite-storage": "6.0.1",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "~10.2.0",
    "react-native-worklets": "0.10.0",
    "square-flags": "npm:@kapowaz/square-flags@^1.5.3",
    "typescript": "~6.0.3",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.36.0",
    "@react-native-community/cli": "20.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.5.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "globals": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "react-native-svg-transformer": "~1.5.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-sqlite-storage"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
